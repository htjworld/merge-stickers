{
  "name": "merge-stickers",
  "version": "0.1.0",
  "description": "내가 머지시킨 오픈소스 PR을 칭찬스티커판처럼 README에 붙여주는 도구",
  "type": "module",
  "bin": {
    "merge-stickers": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "schema": "tsx scripts/gen-schema.ts"
  },
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "opentype.js": "^2.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
