{
  "name": "merge-stickers",
  "version": "1.0.2",
  "description": "Turn every open-source PR you got merged into a collectible sticker on your GitHub profile README.",
  "type": "module",
  "bin": {
    "merge-stickers": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup src/cli.ts --format esm --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "schema": "tsx scripts/gen-schema.ts"
  },
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htjworld/merge-stickers.git"
  },
  "homepage": "https://github.com/htjworld/merge-stickers#readme",
  "keywords": [
    "github-profile",
    "readme",
    "profile-readme",
    "github-actions",
    "stickers",
    "open-source",
    "svg",
    "pull-requests"
  ]
}
